# Keep editor whitespace and line endings consistent; .clang-format handles C++ formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Windows batch and PowerShell scripts use CRLF to avoid cmd parsing problems.
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Preserve Markdown's two trailing spaces, which represent a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{cpp,h,hpp,c,mm,qml,js,py}]
indent_style = space
indent_size = 4

[Makefile*]
indent_style = tab
