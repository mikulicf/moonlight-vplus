# Vendored static libusb for usbipdcpp's pkg_check_modules(libusb-1.0).
# CMake writes this to build/pkgconfig. Put Darwin framework links in Libs,
# because discovery does not use --static and therefore ignores Libs.private.
libdir=@CMAKE_BINARY_DIR@/lib
shim=@CMAKE_BINARY_DIR@/libusb-shim
source=@CMAKE_CURRENT_SOURCE_DIR@

Name: libusb-1.0
Description: libusb static, vendored by moonlight-usbd
Version: 1.0.29
# Use the static archive's absolute path; -lusb-1.0 might select a Homebrew dylib.
Libs: ${libdir}/libusb-1.0.a -lobjc -framework IOKit -framework CoreFoundation -framework Security
Cflags: -I${shim} -I${source}/third_party/libusb/libusb
