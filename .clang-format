# Follow the handwritten Qt style in app/. Do not reformat the entire tree.
# The cpp-format CI job checks only changed lines; existing files converge gradually.
# Pin 21.1.8 to match CI because formatter versions can produce different output.
#   pip install clang-format==21.1.8
#   git clang-format --diff <merge-base>   # Omit --diff to apply changes.
---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4

# Infer pointer alignment from each file's existing style to avoid unrelated changes.
DerivePointerAlignment: true
PointerAlignment: Left

# Qt braces: new lines for functions/classes; same line for control statements.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterControlStatement: Never
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: Inline

# Preserve the handwritten include order to avoid unrelated diff noise.
SortIncludes: Never
IncludeBlocks: Preserve

AlignAfterOpenBracket: Align
AlignConsecutiveMacros: None
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignOperands: Align
AlignTrailingComments: true

# Preserve Qt initializer spacing: { item, item }, with the closing brace on its own line.
Cpp11BracedListStyle: false

SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true

# file-mapping uses namespaces while upstream app/ does not; do not insert namespace comments.
NamespaceIndentation: None
FixNamespaceComments: false
SeparateDefinitionBlocks: Leave
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: true
InsertNewlineAtEOF: true

---
Language: ObjC
# macos.mm mirrors the C++ style below. Without an ObjC section
# clang-format (>=17, incl. the pinned 21.1.8) refuses to process .mm
# files at all, which made the cpp-format gate fail on any PR that
# touches macos.mm. Keep this option block in sync with the Cpp one.
BasedOnStyle: LLVM
Standard: c++17
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4

# Infer pointer alignment from each file's existing style to avoid unrelated changes.
DerivePointerAlignment: true
PointerAlignment: Left

# Qt braces: new lines for functions/classes; same line for control statements.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterControlStatement: Never
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: Inline

# Preserve the handwritten include order to avoid unrelated diff noise.
SortIncludes: Never
IncludeBlocks: Preserve

AlignAfterOpenBracket: Align
AlignConsecutiveMacros: None
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignOperands: Align
AlignTrailingComments: true

# Preserve Qt initializer spacing: { item, item }, with the closing brace on its own line.
Cpp11BracedListStyle: false

SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceAfterCStyleCast: false
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true

# file-mapping uses namespaces while upstream app/ does not; do not insert namespace comments.
NamespaceIndentation: None
FixNamespaceComments: false
SeparateDefinitionBlocks: Leave
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: true
InsertNewlineAtEOF: true
